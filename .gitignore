# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# env
.env
supabase/.temp/
kits/
dist/
.vercel

# 개발자 제출물(내부 정보 포함) — 저장소에 올리지 않음
핏로그_중간제출_*
핏로그_최종제출_*
supabase/.local/

# TWA 서명 키와 비밀번호(절대 커밋 금지)
twa/.local/
# TWA: 생성되는 안드로이드 프로젝트·빌드 결과는 twa-manifest.json 으로 다시 만들 수 있어 올리지 않는다
twa/*
!twa/twa-manifest.json
!twa/README.md

# 개발자 제출 원본(통합 전 코드)은 레포에 올리지 않는다
이미경/
이미경_*.zip
