# 이 파일을 복사해 .env 로 만들고 값을 채운다. .env는 GitHub에 올라가지 않는다.
# Supabase 대시보드 → Project Settings → API 에서 복사
EXPO_PUBLIC_SUPABASE_URL=https://bcxtipigthohmwbxrjkt.supabase.co
# anon 키 또는 sb_publishable_ 로 시작하는 키 (secret/service_role 키는 절대 금지)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 자동 로그인할 계정 (멘토가 Authentication → Users에서 만들어 전달)
EXPO_PUBLIC_LOGIN_EMAIL=
EXPO_PUBLIC_LOGIN_PASSWORD=

# Gemini API 키는 여기 넣지 않는다. 앱의 설정 화면에서 입력한다.
